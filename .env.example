# ─────────────────────────────────────────────────────────────
# Graph-Enhanced Real-Time Fraud Detection — environment template
# Copy to `.env` and adjust. Every value has a safe default, so the
# pipeline runs locally even with an empty .env.
# ─────────────────────────────────────────────────────────────

# ── Stream / data generation ──────────────────────────────────
STREAM_TOTAL=20000
STREAM_BATCH=2000
STREAM_FRAUD_RATIO=0.012
STREAM_ACCOUNTS=4000
STREAM_DEVICES=2500
STREAM_MERCHANTS=800
STREAM_RINGS=12
GRAPH_WINDOW_MINUTES=60
RANDOM_SEED=42

# ── Kafka (optional — leave blank to use the in-memory replay) ─
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=transactions

# ── Model thresholds ──────────────────────────────────────────
MODEL_HIGH_RISK_THRESHOLD=0.85
MODEL_DECLINE_THRESHOLD=0.85
MODEL_CHALLENGE_THRESHOLD=0.45

# ── Redis online feature cache (optional) ─────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Fraud investigation agent ─────────────────────────────────
AGENT_ENABLED=true
AGENT_PROVIDER=template          # template | groq
AGENT_MODEL=mixtral-8x7b-32768
GROQ_API_KEY=
AGENT_MAX_CASES=10

# ── AWS cloud connectivity ────────────────────────────────────
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=fraud-detection
AWS_KINESIS_STREAM=
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
